# AI & DS Department Student Performance, Intelligence & Recognition System
# Environment Variables Template (.env.example)
# Copy this file to '.env' for local development and production deployment configuration.
# WARNING: Never commit actual secret values, passwords, JWT secrets, or API keys to version control!

# ==========================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==========================================
# Environment mode ('development' or 'production')
NODE_ENV="development"

# Express Backend Server Port (Default: 5000)
PORT="5000"

# Secret key for JWT authentication token signing (REQUIRED: Use a strong 32+ char random secret)
JWT_SECRET="your_jwt_secret_key_here_change_in_production"

# Active Database Engine Switch ('true' for SQLite local DB, 'false' for PostgreSQL/Supabase)
USE_SQLITE="true"

# Custom path for local SQLite database file (Optional when USE_SQLITE="true")
DATABASE_PATH="server/data/department_system.db"


# ==========================================
# 2. GOOGLE GEMINI AI CONFIGURATION
# ==========================================
# Google Gemini API key for AI rank explanations, award candidate recommendations, and performance insights
GEMINI_API_KEY="your_google_gemini_api_key_here"


# ==========================================
# 3. INITIAL ADMIN BOOTSTRAP CREDENTIALS
# ==========================================
# Email address for the initial system Admin account created on DB bootstrap
ADMIN_EMAIL="departmentai&ds@gmail.com"

# Password for the initial system Admin account
ADMIN_INITIAL_PASSWORD="your_secure_admin_initial_password"


# ==========================================
# 4. POSTGRESQL / SUPABASE DATABASE CONFIGURATION (Required when USE_SQLITE="false")
# ==========================================
# Primary PostgreSQL Connection URI
DATABASE_URL="postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres"

# Alternative Alias Connection URI (Optional)
SUPABASE_DB_URL="postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres"

# Supabase Project HTTPS Endpoint URL
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public API Key
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Supabase Administrative Service Role Key (Bypasses RLS - Keep strictly secret on server)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Standalone PostgreSQL Connection Parameters
PGHOST="db.your-project.supabase.co"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="your_db_password"
PGDATABASE="postgres"


# ==========================================
# 5. GOOGLE OAUTH CONFIGURATION (FOR NPTEL VERIFIED STUDENT LOGIN)
# ==========================================
# Google OAuth 2.0 Client ID (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Authorized OAuth Callback Redirect URI (Update host domain for production)
GOOGLE_REDIRECT_URI="http://127.0.0.1:5000/api/auth/google/callback"


# ==========================================
# 6. FRONTEND VITE ENVIRONMENT CONFIGURATION
# ==========================================
# Web Application Branding Title
VITE_APP_TITLE="AI & DS Department Student Performance & Recognition System"

# Frontend Environment Mode ('development' or 'production')
VITE_APP_ENV="development"

# Frontend API Base URL (Defaults to relative '/api' path when served by Express backend)
VITE_API_BASE_URL="http://localhost:3000/api"

# Client Salt Identifier
VITE_PORTAL_SALT_KEY="aids_department_salt_v1"
