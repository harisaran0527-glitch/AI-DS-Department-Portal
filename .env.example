VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_PORTAL_SALT_KEY="aids_department_salt_v1"

# ADMIN BOOTSTRAP CREDENTIALS
ADMIN_EMAIL="departmentai&ds@gmail.com"
