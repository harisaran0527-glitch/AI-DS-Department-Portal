# SUPABASE POSTGRESQL DATABASE CONFIGURATION
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.iducgryrqyqjzvqzxgje.supabase.co:5432/postgres"
SUPABASE_URL="https://iducgryrqyqjzvqzxgje.supabase.co"
